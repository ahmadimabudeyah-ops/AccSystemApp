# ---------------------------------------------------------------------------
# Production template — copy to backend/.env and fill in real values.
# app/config.py refuses to boot with FLASK_ENV=production unless SECRET_KEY and
# JWT_SECRET_KEY are at least 32 characters (and not the dev defaults).
# ---------------------------------------------------------------------------
FLASK_APP=wsgi.py
FLASK_ENV=production

# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_CHARS
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_32_CHARS

# Point at the production cluster. Never use the dev demo tenant in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5433/accounting_db

DEFAULT_CURRENCY=JOD
DEFAULT_TIMEZONE=Asia/Amman
# 12 rounds is the bcrypt default and keeps login ~300 ms; lower only for tests.
BCRYPT_LOG_ROUNDS=12
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Production login throttle. Leave at 10 per minute unless a load balancer sits
# in front and rewrites X-Forwarded-For.
LOGIN_RATELIMIT=10 per minute

# JoFotara e-invoicing (Jordanian ZATCA). Leave blank until the certificate is
# issued; the API refuses to submit rather than falling back to the 16% default.
JOFOTARA_SELLER_TAX_ID=
JOFOTARA_API_URL=

# Maintenance key required by POST /api/v1/provisioning/sweep-expired.
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
MAINTENANCE_KEY=

# Run behind a reverse proxy that terminates TLS; waitress/gunicorn stay plain.
TRUSTED_PROXIES=
